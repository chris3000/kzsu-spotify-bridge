# Copy to .env for local development. Production values go in `fly secrets`.

# Required
DASHBOARD_PASSWORD=change-me
COOKIE_SECRET=change-me-to-a-random-string-of-32-plus-chars

# Spotify app credentials (https://developer.spotify.com/dashboard)
# Register redirect URIs:
#   http://127.0.0.1:8080/auth/spotify/callback   (local dev)
#   https://<your-app>.fly.dev/auth/spotify/callback  (production)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Optional overrides (defaults shown)
#PORT=8080
#DATABASE_PATH=./data/kzsu.db
#PUBLIC_BASE_URL=http://127.0.0.1:8080
#FEED_URL=http://kzsu.rocks/songs
#DYNAMIC_PLAYLIST_NAME=Indie Rock Dynamic Playlist
#YESTERDAY_PLAYLIST_NAME=Zootopia- Yesterday's Songs
#PLAYLIST_SIZE=150
#COOLDOWN_DAYS=14
#STALENESS_HALF_DAYS=30
#STALENESS_CAP=4
#MATCH_THRESHOLD=0.80
#TZ_STATION=America/Los_Angeles
#LOG_LEVEL=info
